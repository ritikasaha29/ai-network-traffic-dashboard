{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Launch Streamlit Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/dashboard/app.py",
                "--server.port=8501",
                "--server.headless=false"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "💻 Run Terminal CLI Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo_cli.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "🧪 Run Unit & Integration Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_pipeline.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
